{
  "name": "solar-system",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^24"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "rollup": "^4.62.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "cypress": "^15.19.0",
    "cypress-axe": "^1.7.0",
    "eslint": "^10.8.0",
    "eslint-plugin-check-file": "^3.3.2",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "check": "npm run type-check && npm run lint && npm test",
    "prepare": "git config core.hooksPath .githooks",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run --headless"
  }
}
